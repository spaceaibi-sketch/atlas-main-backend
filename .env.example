# Copy to .env and set real credentials. .env is private; never commit it.
# Environment variables and explicit CLI flags override values from this file.
# AI provider: openai (default/backward compatible) or openrouter.
# Only the selected provider's key is required. No keys are included here.
AI_PROVIDER=openai
# OpenAI Responses API settings (used when AI_PROVIDER=openai)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
NEWS_OPENAI_MODEL=gpt-5-mini
# OpenRouter Responses API settings (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
NEWS_OPENROUTER_MODEL=openai/gpt-5-mini
# Shared Responses API timeout; when unset, OPENAI_TIMEOUT_SECONDS is used.
AI_TIMEOUT_SECONDS=300
OPENAI_TIMEOUT_SECONDS=300
NEWS_PHASE1_TIMEOUT_SECONDS=300
SEC_USER_AGENT=Atlas your.real.email@example.com
SEC_DB_PATH=/opt/atlas/data/edgar.sqlite3
SEC_DASH_HOST=127.0.0.1
SEC_DASH_PORT=8050
# Optional dashboard protection (required for DB Explorer)
ATLAS_DB_EXPLORER_TOKEN=
ATLAS_LOG_PATH=
# SQLite: maximum time to wait for an active writer (milliseconds)
# No journal-mode changes or schema migrations occur during extraction.
ATLAS_SQLITE_BUSY_TIMEOUT_MS=60000
# SEC extraction
SEC_COMPANIES_URL=https://www.sec.gov/files/company_tickers_exchange.json
SEC_COMPANY_REFRESH_HOURS=24
SEC_MAX_ATOM_PAGES=100
SEC_FORMS_LIMIT=500
# News collection + Phase 1 AI
NEWS_SOURCES_CSV=assets/news_sources.csv
NEWS_MAX_FEEDS=0
NEWS_MAX_ENTRIES=0
NEWS_MAX_NEW=0
NEWS_PHASE1_LIMIT=0
NEWS_PHASE1_BATCH_SIZE=500
# News Phase 2 scoring: relationships per request
NEWS_SCORING_LIMIT=100
NEWS_SCORING_BATCH_SIZE=20
# SEC Item scoring: Items per request
SEC_AI_LIMIT=25
SEC_AI_BATCH_SIZE=20
# Price collection (--source alpaca, yfinance, or massive)
PRICE_SOURCE=alpaca
YFINANCE_TIMEOUT_SECONDS=20
# Massive price collection: copy your API KEY VALUE privately, not a dashboard URL or key ID.
MASSIVE_API_KEY=
# Basic tier: at most 5 requests per minute; reduce only if your plan allows.
MASSIVE_MIN_INTERVAL_SECONDS=12.5
MASSIVE_THREADS=4
MASSIVE_MAX_ATTEMPTS=3
MASSIVE_CONNECT_TIMEOUT_SECONDS=5
MASSIVE_READ_TIMEOUT_SECONDS=30
# Alpaca price collection
ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_API_SECRET=YOUR_ALPACA_API_SECRET
ALPACA_FEED=sip
# Cron, hours between runs; 0 means disabled
ATLAS_CRON_SEC_FILINGS_HOURS=1
ATLAS_CRON_SEC_ITEMS_HOURS=1
ATLAS_CRON_NEWS_HOURS=3
ATLAS_CRON_SEC_AI_HOURS=1
ATLAS_CRON_NEWS_AI_HOURS=3
# Massive price collection, every 3 hours (0 disables this job)
ATLAS_CRON_MASSIVE_PRICES_HOURS=3
# Optional Python runtime path for shell launchers; leave blank for automatic selection
SEC_PYTHON_EXE=
# Rate limits and request timeouts
SEC_HTTP_MIN_INTERVAL_SECONDS=0.25
SEC_HTTP_MAX_ATTEMPTS=3
SEC_HTTP_CONNECT_TIMEOUT_SECONDS=8
SEC_HTTP_READ_TIMEOUT_SECONDS=20
ALPACA_MIN_INTERVAL_SECONDS=0.36
ALPACA_MAX_ATTEMPTS=3
ALPACA_CONNECT_TIMEOUT_SECONDS=5
ALPACA_READ_TIMEOUT_SECONDS=20
NEWS_HTTP_TIMEOUT_SECONDS=15
NEWS_HTTP_MIN_INTERVAL_SECONDS=0.25
NEWS_HTTP_USER_AGENT=SEC-EDGAR-News-Research/1.0 (RSS ingestion)
NEWS_INGEST_WINDOW_HOURS=3
NEWS_COMPANY_CONTEXT_CHARS=1500
NEWS_COMPANY_REQUEST_MAX_BYTES=700000
NEWS_DEDUP_REQUEST_MAX_BYTES=700000
NEWS_MAX_EXPOSURES=80
NEWS_ARTICLE_HTTP_TIMEOUT_SECONDS=8

# Read-only Dash operations overview refresh (milliseconds) and log scan bound
ATLAS_DASH_OVERVIEW_REFRESH_MS=10000
ATLAS_DASH_LOG_SCAN_BYTES=2097152
